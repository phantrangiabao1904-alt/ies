# Chỉ URL và anon key được phép ở đây. KHÔNG thêm service role key vào project này.
# Không dùng tiền tố NEXT_PUBLIC_ cho các biến này: code chỉ chạy trên server.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# Liên hệ hiển thị công khai (NEXT_PUBLIC_ là bắt buộc vì dùng ở trình duyệt).
NEXT_PUBLIC_HOTLINE_DISPLAY=
NEXT_PUBLIC_HOTLINE_TEL=
NEXT_PUBLIC_ZALO_URL=

# Tracking: để trống thì không nạp pixel. Không tự điền ID giả.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
